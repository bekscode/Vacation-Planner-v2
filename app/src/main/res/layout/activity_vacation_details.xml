<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/offWhite"
    tools:context=".UI.VacationDetails">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutVacationTitle"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="32dp"
        app:boxBackgroundColor="@color/white"
        android:hint="Vacation Title"
        app:boxStrokeColor="@color/lightGreen"
        app:hintTextColor="@color/lightGreen"
        app:cursorColor="@color/lightGreen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/vacationTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>


    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutHotel"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:boxBackgroundColor="@color/white"
        android:hint="Hotel Name"
        app:boxStrokeColor="@color/lightGreen"
        app:hintTextColor="@color/lightGreen"
        app:cursorColor="@color/lightGreen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textInputLayoutVacationTitle">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/hotelNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutStartDate"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="2dp"
        app:boxBackgroundColor="@color/white"
        android:hint="Start Date"
        app:boxStrokeColor="@color/lightGreen"
        app:hintTextColor="@color/lightGreen"
        app:cursorColor="@color/lightGreen"
        app:layout_constraintEnd_toStartOf="@+id/textInputLayoutEndDate"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textInputLayoutHotel">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/vacationStartInput"
            android:inputType="date"
            android:clickable="true"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/textInputLayoutEndDate"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="32dp"
        app:boxBackgroundColor="@color/white"
        android:hint="End Date"
        app:boxStrokeColor="@color/lightGreen"
        app:hintTextColor="@color/lightGreen"
        app:cursorColor="@color/lightGreen"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/textInputLayoutStartDate"
        app:layout_constraintTop_toBottomOf="@+id/textInputLayoutHotel">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/vacationEndInput"
            android:inputType="date"
            android:clickable="true"
            android:focusable="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/associatedExcursionsLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="136dp"
        android:text="Associated Excursions"
        android:textColor="@color/darkGreen"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textInputLayoutEndDate" />

    <Button
        android:id="@+id/addExcursionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/darkGreen"
        android:drawableEnd="@drawable/round_add_24"
        android:fontFamily="sans-serif"
        android:text="Add Excursion"
        android:textAlignment="center"
        android:textColor="@color/offWhite"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/vacationDetailsRecyclerView"
        android:layout_width="410dp"
        android:layout_height="204dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="126dp"
        android:background="@color/lightGreen"
        android:nestedScrollingEnabled="false"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/addExcursionButton"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/associatedExcursionsLabel" />

</androidx.constraintlayout.widget.ConstraintLayout>